---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const year = new Date().getFullYear();
---

<footer class="sl-flex">
	{/* Link de edição + data da última atualização e paginação anterior/próxima. */}
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	{/* Crédito "Built with Starlight" (exibido apenas se a configuração `credits` do Starlight estiver ativada). */}
	{
		config.credits && (
			<a class="kudos sl-flex" href="https://starlight.astro.build">
				<Icon name={'starlight'} /> {Astro.locals.t('builtWithStarlight.label')}
			</a>
		)
	}

	{/* Linha de direitos autorais. */}
	<div class="site-footer-copyright">© {year} <a href="https://github.com/RamonMods/WinUtil">RamonMods</a>. Todos os direitos reservados. · <a href="https://pixgg.com/ramon">Apoiar via Pix</a></div>
</footer>

<style>
	@layer starlight.core {
		/* Layout do rodapé: linha de metadados empilhada + paginação. */
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		/* Link de crédito "Built with Starlight". */
		.kudos {
			align-items: center;
			gap: 0.5em;
			margin: 1.5rem auto;
			font-size: var(--sl-text-xs);
			text-decoration: none;
			color: var(--sl-color-gray-3);
		}
		.kudos:hover {
			color: var(--sl-color-white);
		}
	}

	@layer starlight.components {
		.kudos :global(svg) {
			color: var(--sl-color-orange);
		}
	}

	/* Recolhe totalmente as linhas de metadados/paginação quando não há nada nelas (ex.: editUrl: false e sem anterior/próxima), em vez de deixar um espaço vazio. */
	footer .meta:empty,
	footer :global(.pagination-links):empty {
		display: none;
		margin: 0;
	}

	/* Linha de direitos autorais de todo o site, equivalente ao rodapé do antigo site de documentos em Hugo. O divisor acima vem da própria borda .content-panel do Starlight. */
	.site-footer-copyright {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.site-footer-copyright a {
		color: inherit;
		text-decoration: underline;
	}
	.site-footer-copyright a:hover {
		color: var(--sl-color-white);
	}
</style>
