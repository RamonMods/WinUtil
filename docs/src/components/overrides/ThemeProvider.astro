---
// Substitui o ThemeProvider padrão do Starlight: escuro por padrão, independentemente da preferência do sistema, a menos que o visitante já tenha escolhido um tema explicitamente.
---

<script is:inline>
	// Aplica o tema resolvido a <html> imediatamente, antes da pintura, para evitar um lampejo do tema errado.
	(() => {
		let storedTheme = null;
		try {
			storedTheme = localStorage.getItem('starlight-theme');
		} catch {
			// O armazenamento pode estar bloqueado; usa-se então o padrão escuro.
		}
		document.documentElement.dataset.theme = storedTheme === 'light' ? 'light' : 'dark';
	})();
</script>
