---
// Substituição do cabeçalho: título do site, busca, navegação superior, links sociais e alternador de tema.
import config from 'virtual:starlight/user-config';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import { Icon } from '@astrojs/starlight/components';
import SearchDialog from '../docs/SearchDialog.jsx';
import SiteNav from '../docs/SiteNav.jsx';
import ThemeToggle from '../docs/ThemeToggle.jsx';
import { siteLinks } from '../../lib/site-links';
import '../../styles/docs-ui.css';

// Páginas com barra lateral já têm o botão de menu dela, então só as páginas de abertura precisam do do SiteNav.
const { hasSidebar } = Astro.locals.starlightRoute;

const navGroups = [
	{
		label: 'Documentação',
		links: [
			{ label: 'Guias do usuário', href: '/guides/' },
			{ label: 'Guias de contribuição', href: '/contributing/' },
			{ label: 'Referência de código', href: '/code-reference/architecture/' },
		],
	},
	{
		label: 'Ferramentas',
		links: [
			{ label: 'Construtor de Configurações', href: '/config-builder/' },
			{ label: 'Explorador de Ajustes', href: '/tweak-explorer/' },
		],
	},
	{
		label: 'Ajuda',
		links: [
			{ label: 'FAQ', href: '/faq/' },
			{ label: 'Problemas conhecidos', href: '/knownissues/' },
			{ label: siteLinks.forums.label, href: siteLinks.forums.href, external: true },
		],
	},
];

const navLinks = [{ ...siteLinks.store, external: true }];
---

<div class="docs-header">
	<div class="docs-header-title">
		<SiteTitle />
	</div>
	<div class="docs-header-actions print:hidden">
		<SearchDialog client:load />
		<SiteNav client:idle groups={navGroups} links={navLinks} showMenuButton={!hasSidebar} />
		<div class="docs-social">
			{
				config.social?.map(({ icon, label, href }) => (
					<a href={href} class="docs-icon-button" rel="me">
						<Icon name={icon} label={label} />
					</a>
				))
			}
		</div>
		<ThemeToggle client:load />
	</div>
</div>
