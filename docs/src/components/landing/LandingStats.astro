---
// Conta as páginas de referência de ajustes e recursos geradas, para que os números acompanhem config/tweaks.json e feature.json.
import { getCollection } from 'astro:content';

const docs = await getCollection('docs');
const countPages = (dir: string) => docs.filter((entry) => entry.id.startsWith(`code-reference/${dir}/`)).length;

const stats = [
	{ value: countPages('tweaks'), label: 'Ajustes documentados' },
	{ value: countPages('features'), label: 'Recursos e correções' },
];
---

<div class="wu-stats">
	{
		stats.map(({ value, label }) => (
			<div class="wu-stat">
				<span class="wu-stat-value">{value}</span>
				<span class="wu-stat-label">{label}</span>
			</div>
		))
	}
</div>
